{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "receipt",
  "type": "object",
  "properties": {
    "store": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"], "description": "Store name as printed." },
        "address": { "type": ["string", "null"] }
      },
      "required": ["name", "address"]
    },
    "date": {
      "type": ["string", "null"],
      "x-field-type": "date",
      "description": "Purchase date.",
      "examples": ["05/01/2026"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": ["string", "null"] },
          "quantity": { "type": ["number", "null"], "x-field-type": "number" },
          "price": { "type": ["number", "null"], "x-field-type": "number" }
        },
        "required": ["name", "quantity", "price"]
      }
    },
    "total": { "type": ["number", "null"], "x-field-type": "number", "description": "Amount paid." },
    "loyalty_points": {
      "type": ["number", "null"],
      "x-mode": "derive",
      "description": "Points earned, computed from the total by the customer's rule."
    }
  },
  "required": ["store", "date", "items", "total"],
  "x-decoys": [
    { "name": "container_number", "description": "Number of the shipping container." },
    { "name": "vessel_name", "description": "Name of the ship." }
  ]
}
